<script>
import { NModal } from 'naive-ui'

export default {
  name: 'DashboardPage',

  components: {
    NModal
  },

  data() {
    return {
      menuOpen: false,
      showContactModal: false,
      cacheUsername:localStorage.getItem('username') || ''
    }
  },
 /* 
  async created(){
      if (this .$store.getters.isLoggedIn) {
